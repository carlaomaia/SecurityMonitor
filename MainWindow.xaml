<Window
    x:Class="SecurityMonitor.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SecurityMonitor"
    Title="Security Status Monitor">

    <Grid Background="#121212" Padding="20">

        <Grid.Resources>
            <SolidColorBrush x:Key="CianoSidebarBrush" Color="#00BCD4" />

            <Style x:Key="CartaoEscuroStyle" TargetType="Border">
                <Setter Property="Background" Value="#1E1E1E"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Margin" Value="0,4"/>
                <Setter Property="Padding" Value="10,0"/>
                <Setter Property="Height" Value="55"/>
            </Style>
        </Grid.Resources>

        <StackPanel Spacing="15">
            <TextBlock Text="RECURSOS DE SEGURANÇA RECOMENDADOS" 
                       Foreground="#888888" 
                       FontWeight="SemiBold"
                       FontSize="12"
                       Margin="0,0,0,10"
                       CharacterSpacing="25"/>

            <ListView x:Name="RequirementsList" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:SecurityRequirement">

                        <Border Style="{StaticResource CartaoEscuroStyle}">
                            <Grid ColumnDefinitions="5, *, Auto">

                                <Rectangle Grid.Column="0" 
                                           Width="3" Height="30" 
                                           Fill="{StaticResource CianoSidebarBrush}"
                                           VerticalAlignment="Center" 
                                           HorizontalAlignment="Left"
                                           RadiusX="1.5" RadiusY="1.5"/>

                                <TextBlock Grid.Column="1" 
                                           Text="{x:Bind Title}" 
                                           Foreground="White"
                                           FontSize="15" 
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Margin="20,0,0,0"/>

                                <!-- CORREÇÃO: O Texto e a Cor agora são dinâmicos (OneWay) -->
                                <TextBlock Grid.Column="2" 
                                           Text="{x:Bind IconGlyph, Mode=OneWay}" 
                                           Foreground="{x:Bind IconBrush, Mode=OneWay}"
                                           FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                           FontSize="16" 
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"
                                           Margin="0,0,15,0"/>
                            </Grid>
                        </Border>

                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

        </StackPanel>
    </Grid>
</Window>