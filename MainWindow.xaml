<Window
    x:Class="SecurityMonitor.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SecurityMonitor"
    Title="Security Status Monitor">

    <Grid Background="#121212" Padding="20">

        <Grid.Resources>
            <SolidColorBrush x:Key="CianoSidebarBrush" Color="#00BCD4" />

            <Style x:Key="CartaoEscuroStyle" TargetType="Border">
                <Setter Property="Background" Value="#1E1E1E"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Margin" Value="0,4"/>
                <Setter Property="Padding" Value="10,10"/>
                <Setter Property="MinHeight" Value="70"/>
            </Style>
        </Grid.Resources>

        <StackPanel Spacing="15">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="RECURSOS DE SEGURANÇA RECOMENDADOS" 
                           Foreground="#888888" 
                           FontWeight="SemiBold"
                           FontSize="12"
                           CharacterSpacing="25"
                           VerticalAlignment="Center"/>

                <Button x:Name="RefreshButton"
                        Grid.Column="1"
                        Content="Verificar novamente"
                        Background="#00BCD4"
                        Foreground="White"
                        Padding="12,6"/>
            </Grid>

            <ListView x:Name="RequirementsList" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:SecurityRequirement">

                        <Border Style="{StaticResource CartaoEscuroStyle}">
                            <Grid ColumnDefinitions="5, *, Auto">

                                <Rectangle Grid.Column="0" 
                                           Width="3" Height="30" 
                                           Fill="{StaticResource CianoSidebarBrush}"
                                           VerticalAlignment="Center" 
                                           HorizontalAlignment="Left"
                                           RadiusX="1.5" RadiusY="1.5"/>

                                <StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Title}" 
                                               Foreground="White"
                                               FontSize="15" 
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="{x:Bind StatusText, Mode=OneWay}" 
                                               Foreground="#A8A8A8"
                                               FontSize="12"
                                               Margin="0,2,0,0"/>
                                    <TextBlock Text="{x:Bind Details, Mode=OneWay}" 
                                               Foreground="#7A7A7A"
                                               FontSize="11"
                                               TextWrapping="WrapWholeWords"
                                               Margin="0,2,0,0"/>
                                </StackPanel>

                                <TextBlock Grid.Column="2" 
                                           Text="{x:Bind IconGlyph, Mode=OneWay}" 
                                           Foreground="{x:Bind IconBrush, Mode=OneWay}"
                                           FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                           FontSize="16" 
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"
                                           Margin="0,0,15,0"/>
                            </Grid>
                        </Border>

                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

        </StackPanel>
    </Grid>
</Window>